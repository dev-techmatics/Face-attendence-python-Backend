# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Local configuration ---------------------------------------------------
.env
appsettings.Local.json

# ---- Runtime data ----------------------------------------------------------
# Face images and the database hold biometric personal data. Never commit them.
storage/
*.db
*.db-journal
*.sqlite3

# ---- Models ----------------------------------------------------------------
# ~5MB and ~250MB; download them with scripts/download_models.py instead.
models/*.onnx

# ---- Reference copy of the original C# service -----------------------------
_src/
_install.log

# ---- Test fixtures ---------------------------------------------------------
# Face photographs are personal data and not ours to redistribute. See the README
# for what tests/fixtures/ needs; the ONNX tests skip when it is empty.
tests/fixtures/*.jpg
tests/fixtures/*.png
models/MODELS.txt

# ---- Deployment secrets and local data -------------------------------------
# .env.production holds the API keys; API-KEYS.txt is a password store; certs/ holds a
# private key; data/ holds face photographs.
.env.production
deploy/API-KEYS.txt
# Written by deploy/app_team_note.py: a handover note with the kiosk key filled in.
deploy/APP-TEAM-NOTE.txt
deploy/certs/
# Staging folder for a handover: copies of the note (live device key) and the public
# certificate, kept apart from deploy/ so that nobody attaches API-KEYS.txt by mistake -
# that file holds the ADMIN key, which can download every stored face photograph.
deploy/to-send/
data/
