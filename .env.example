# Environment variables override appsettings*.json. Prefix FA_, nest with __.

FA_ENVIRONMENT=Development

# ---- Database --------------------------------------------------------------
# SQLite needs nothing installed and is the default:
FA_DATABASE__URL=sqlite+aiosqlite:///./face_attendance.db
# SQL Server Express over ODBC Driver 18 (pip install -r requirements-mssql.txt):
# FA_DATABASE__URL=mssql+aioodbc://@localhost\SQLEXPRESS/FaceAttendance?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
FA_DATABASE__MIGRATE_ON_STARTUP=true

# ---- API keys --------------------------------------------------------------
# Admin keys may do everything; device keys may only mark attendance.
FA_API_KEYS__ADMIN=["dev-admin-key"]
FA_API_KEYS__DEVICE=["dev-device-key"]

# ---- Recognition -----------------------------------------------------------
# onnx | aws | development   ("development" matches on file name, not on faces)
FA_FACE__PROVIDER=development
# FA_FACE__VERIFICATION_THRESHOLD=0.42
# FA_FACE__IDENTIFICATION_THRESHOLD=0.52
# FA_FACE__ONNX__DETECTOR_MODEL_PATH=models/scrfd_detector.onnx
# FA_FACE__ONNX__RECOGNITION_MODEL_PATH=models/arcface_recognizer.onnx

# ---- Storage ---------------------------------------------------------------
# local | s3
FA_STORAGE__PROVIDER=local
FA_STORAGE__LOCAL_ROOT_PATH=storage/faces
# FA_STORAGE__S3__BUCKET_NAME=my-face-bucket

# ---- CORS ------------------------------------------------------------------
FA_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
